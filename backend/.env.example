SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Production (PostgreSQL): postgres://USER:PASSWORD@HOST:25060/DBNAME?sslmode=require
DATABASE_URL=sqlite:///db.sqlite3
CELERY_BROKER_URL=redis://localhost:6379/0
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
SENDGRID_API_KEY=
# Sender for all mail — must be verified in SendGrid (single sender or authenticated domain)
DEFAULT_FROM_EMAIL=StepsDoor <noreply@stepsdoor.in>
# Dev only: uncomment to send real mail through SendGrid instead of printing to the console
# EMAIL_BACKEND=anymail.backends.sendgrid.EmailBackend
FIREBASE_CREDENTIALS_PATH=
# Affiliate — fill in after signing up
AMAZON_AFFILIATE_TAG=
CUELINKS_PUBLISHER_ID=
# Comma-separated addresses for the daily failing-scraper alert (empty = worker log only)
SCRAPER_ALERT_EMAILS=
# Public web app URL — used for links in alert emails
FRONTEND_URL=http://localhost:3000
